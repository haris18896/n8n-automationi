COMPOSE_PROJECT_NAME=ai_pipeline

GENERIC_TIMEZONE=Asia/Karachi

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_now
N8N_ENCRYPTION_KEY=replace_with_a_long_random_string_32_chars_minimum

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=n8n

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

VIDEO_PROCESSOR_PORT=8000
WHISPER_MODEL=small.en
TRANSCRIBE_DEVICE=cpu
TRANSCRIBE_COMPUTE_TYPE=int8
DEFAULT_TARGET_RATIO=9:16
DEFAULT_CLIP_MIN_SECONDS=20
DEFAULT_CLIP_MAX_SECONDS=45
DEFAULT_TOP_K_SEGMENTS=5

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
