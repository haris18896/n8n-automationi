{
  "name": "YouTube Video Clipper - Google Sheets Orchestrator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": "PASTE_YOUR_GOOGLE_SHEET_ID_HERE",
        "sheetName": "Jobs"
      },
      "id": "2",
      "name": "Read Jobs Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        500,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all(); return rows.filter(item => (String(item.json.status || '').toLowerCase() === 'pending'));"
      },
      "id": "3",
      "name": "Filter Pending Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({json:{job_id:item.json.job_id,mode:(item.json.mode||'auto').toLowerCase(),youtube_url:item.json.youtube_url,start_time:item.json.start_time||null,end_time:item.json.end_time||null,desired_duration:Number(item.json.desired_duration||30),language:item.json.language||'en',subtitle_enabled:String(item.json.subtitle_enabled).toUpperCase()==='TRUE',cta_enabled:String(item.json.cta_enabled).toUpperCase()==='TRUE',watermark_enabled:String(item.json.watermark_enabled).toUpperCase()==='TRUE',watermark_text:item.json.watermark_text||''}}));"
      },
      "id": "4",
      "name": "Build Processor Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://video-processor:8000/process",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ $json }}"
      },
      "id": "5",
      "name": "Process Clip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1240,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($json.success) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "6",
      "name": "Was Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1480,
        320
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Read Jobs Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Jobs Sheet": {
      "main": [
        [
          {
            "node": "Filter Pending Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Pending Jobs": {
      "main": [
        [
          {
            "node": "Build Processor Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Processor Payload": {
      "main": [
        [
          {
            "node": "Process Clip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Clip": {
      "main": [
        [
          {
            "node": "Was Successful?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false
}